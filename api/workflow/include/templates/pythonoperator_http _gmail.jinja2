from airflow import DAG
from airflow.operators.python import PythonOperator
from airflow.models.baseoperator import chain
from airflow.models import Variable



import requests, time, random, pendulum,json, os

GRAPH_API_VERSION = "v16.0"   # use the Graph version you target
FB_OAUTH_ENDPOINT = f"https://graph.facebook.com/{GRAPH_API_VERSION}/oauth/access_token"
default_args = {"owner": "airflow", "start_date": pendulum.now("Africa/Nairobi").subtract(days=1)}

def exchange_short_for_long(app_id: str, app_secret: str, short_lived_token: str):
    params = {
        "grant_type": "fb_exchange_token",
        "client_id": app_id,
        "client_secret": app_secret,
        "fb_exchange_token": short_lived_token
    }
    r = requests.get(FB_OAUTH_ENDPOINT, params=params, timeout=10)
    print(r.json())
    return r.json()  # contains access_token and expires_in

def debug_token(input_token: str, app_access_token: str):
    # app_access_token: "<APP_ID>|<APP_SECRET>" or an app token obtained securely
    url = f"https://graph.facebook.com/{GRAPH_API_VERSION}/debug_token"
    params = {"input_token": input_token, "access_token": app_access_token}
    r = requests.get(url, params=params, timeout=10)
    print(r.json())
    return r.json()

def validate_or_extend_token(token: str = None):
    print(f"{Variable.get('FACEBOOK_APP_ID')}|{Variable.get('FACEBOOK_APP_SECRET')}")
    debug_response = debug_token(token, f"{Variable.get('FACEBOOK_APP_ID')}|{Variable.get('FACEBOOK_APP_SECRET')}")
    debug_result = debug_response.get('data', {})
    is_valid = debug_result.get('is_valid', False)
    if is_valid:
        print("Token is valid: No need to extend.")
        return token
    else:
        print("Token is invalid or expired: Extending token.")
        token_resp = exchange_short_for_long(Variable.get('FACEBOOK_APP_ID'), Variable.get('FACEBOOK_APP_SECRET'), token)
        return token_resp.get('access_token', None)
    

def sequential_http(method="GET", endpoint="http://your-api/facebook/users/me/", payloads=None, headers=None):
    if payloads is None:
        payloads = [{}]

    for payload in payloads:
        resp = requests.request(
            method,
            f"https://lunyamwi.org{endpoint}",
            json=payload,
            headers=headers,
            params=payload if method.upper() == "GET" else None,
            data=payload if method.upper() == "POST" or method.upper() == "PUT" or method.upper() == "PATCH" else None
        )
        print(f"Response: {resp.status_code} -> {resp.text}")
        wait_time = random.randint(10, 20)  # your requested range
        print(f"Sleeping {wait_time} seconds...")
        time.sleep(wait_time)


{% set http_tasks = [] %}
http_tasks = []
# Initialize the DAG
{% for dag_ in dag %}
with DAG(
    "{{dag_.dag_id}}",
    default_args=default_args,
    description="{{dag_.description}}",
    schedule="{{dag_.schedule_interval}}"
) as dag:



    {% for operator in operators %}

    {% if operator.data %}
        task = PythonOperator.partial(
            task_id="{{ operator.task_id }}",
            python_callable=sequential_http
        ).expand(
            op_kwargs=[
                {
                    "method": "{{ operator.method }}",
                    "endpoint": "{{ operator.endpoint }}",
                    "payloads": [json.dumps(x) for x in {{ operator.data }}],  # Assuming data is a list of dictionaries
                    "headers": {
                        "Authorization": f"Bearer {validate_or_extend_token('{{ operator.token }}')}",
                        "Content-Type": "application/json"
                    },
                }
            ]
        )
        http_tasks.append(task)
    {% else %}
        task = PythonOperator(
            task_id="{{ operator.task_id }}",
            python_callable=sequential_http,
            op_kwargs={
                "method": "{{ operator.method }}",
                "endpoint": "{{ operator.endpoint }}",
                "payloads": [json.dumps({})],  # Empty payload
                "headers": {
                    "Authorization": "Bearer {{ operator.token }}",
                    "Content-Type": "application/json"
                },
            }
        )
        http_tasks.append(task)
    {% endif %}

        chain(*http_tasks)
    {% endfor %}
{% endfor %}
