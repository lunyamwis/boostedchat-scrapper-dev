from airflow import DAG
from airflow.operators.python import PythonOperator
from airflow.models.baseoperator import chain
import requests, time, random, pendulum,json


default_args = {"owner": "airflow", "start_date": pendulum.now("Africa/Nairobi").subtract(days=1)}

def sequential_http(method="GET", endpoint="http://your-api/facebook/users/me/", payloads=None, headers=None):
    if payloads is None:
        payloads = [{}]

    for payload in payloads:
        resp = requests.request(
            method,
            f"https://lunyamwi.org{endpoint}",
            json=payload,
            headers=headers,
            params=payload if method.upper() == "GET" else None,
            data=payload if method.upper() == "POST" or method.upper() == "PUT" or method.upper() == "PATCH" else None
        )
        print(f"Response: {resp.status_code} -> {resp.text}")
        wait_time = random.randint(10, 20)  # your requested range
        print(f"Sleeping {wait_time} seconds...")
        time.sleep(wait_time)


{% set http_tasks = [] %}
http_tasks = []
# Initialize the DAG
{% for dag_ in dag %}
with DAG(
    "{{dag_.dag_id}}",
    default_args=default_args,
    description="{{dag_.description}}",
    schedule="{{dag_.schedule_interval}}"
) as dag:



    {% for operator in operators %}

    {% if operator.data %}
        task = PythonOperator.partial(
            task_id="{{ operator.task_id }}",
            python_callable=sequential_http
        ).expand(
            op_kwargs=[
                {
                    "method": "{{ operator.method }}",
                    "endpoint": "{{ operator.endpoint }}",
                    "payloads": [json.dumps(x) for x in {{ operator.data }}],  # Assuming data is a list of dictionaries
                    "headers": {
                        "Authorization": "Bearer {{ operator.token }}",
                        "Content-Type": "application/json"
                    },
                }
            ]
        )
        http_tasks.append(task)
    {% else %}
        task = PythonOperator(
            task_id="{{ operator.task_id }}",
            python_callable=sequential_http,
            op_kwargs={
                "method": "{{ operator.method }}",
                "endpoint": "{{ operator.endpoint }}",
                "payloads": [json.dumps({})],  # Empty payload
                "headers": {
                    "Authorization": "Bearer {{ operator.token }}",
                    "Content-Type": "application/json"
                },
            }
        )
        http_tasks.append(task)
    {% endif %}

        chain(*http_tasks)
    {% endfor %}
{% endfor %}
